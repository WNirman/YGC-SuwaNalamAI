# ============================================================
# Suwa Nalam AI — Environment Variables
# Copy to .env.local for local dev or configure in Vercel Project Settings
# ============================================================

# Primary AI Provider (Groq — fast & free tier)
GROQ_API_KEY=
# Optional model overrides (defaults shown):
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Secondary AI Provider (OpenAI fallback)
OPENAI_API_KEY=
# Optional model overrides (defaults shown):
# OPENAI_VISION_MODEL=gpt-6.1-terra
# OPENAI_TEXT_MODEL=gpt-6-luna

# Tertiary AI Provider & Native Scanned-PDF / Sinhala & Tamil Primary (Google Gemini)
GEMINI_API_KEY=
# Optional model override (default shown):
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Places API (New) for live hospital search & photos
GOOGLE_MAPS_API_KEY=
